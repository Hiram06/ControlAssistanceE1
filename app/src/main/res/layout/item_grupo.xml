<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp"
    android:layout_marginBottom="15dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <CheckBox
            android:id="@+id/checkboxGrupo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvNombreGrupo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvPuntoRojo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#E74C3C"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_gravity="center_vertical"/>

    </LinearLayout>

    <!-- Detalles del grupo — solo visible en modo admin al hacer click -->
    <LinearLayout
        android:id="@+id/llDetallesGrupo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#F8F9FA"
        android:padding="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvDetalleMaestro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#000000"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDetalleAlumnos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#000000"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvDetalleId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#666666"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvIdGrupo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#000000"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/llBotones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnLista"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Lista"
            android:textAllCaps="false"
            android:singleLine="true"
            android:backgroundTint="#4F6BED"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnAsistencia"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Asistencia"
            android:textAllCaps="false"
            android:singleLine="true"
            android:backgroundTint="#4F6BED"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btnReporte"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="Reporte"
            android:textAllCaps="false"
            android:singleLine="true"
            android:backgroundTint="#4F6BED"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

    <!-- Botón inscripción QR — solo visible en modo maestro -->
    <Button
        android:id="@+id/btnInscripcionQR"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="QR Inscripción"
        android:backgroundTint="#27AE60"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:singleLine="true"
        android:layout_marginTop="6dp"
        android:visibility="gone"/>

    <!-- btnEliminarGrupo se conserva oculto para no romper el ViewHolder -->
    <Button
        android:id="@+id/btnEliminarGrupo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Eliminar grupo"
        android:backgroundTint="#C0392B"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>

</LinearLayout>