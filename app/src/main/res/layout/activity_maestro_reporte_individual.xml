<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundGray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- FRANJA SUPERIOR -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:background="@color/primaryBlue"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvTituloIndividual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="72dp"
                android:layout_marginBottom="27dp"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </RelativeLayout>

        <!-- CONTENIDO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/inputGray"
                android:textColor="@color/textPrimary"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:text="Alumno: Juan Pérez"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/inputGray"
                android:textColor="@color/textPrimary"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:text="Matrícula: 2092351"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/inputGray"
                android:textColor="@color/textPrimary"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:text="Asistencias: 8 / 10"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:background="@color/inputGray"
                android:textColor="@color/textPrimary"
                android:gravity="center_vertical"
                android:paddingStart="15dp"
                android:text="Porcentaje: 80%"
                android:textStyle="bold"
                android:layout_marginBottom="40dp"/>

            <Button
                android:id="@+id/btnCerrarIndividual"
                android:layout_width="220dp"
                android:layout_height="55dp"
                android:layout_gravity="center"
                android:backgroundTint="@color/primaryBlue"
                android:text="Cerrar"
                android:textAllCaps="false"
                android:textColor="@color/white"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>