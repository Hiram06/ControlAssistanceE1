<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundGray">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@color/primaryBlue"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROL-ASSISTENCE"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"/>
    </RelativeLayout>

    <Button
        android:id="@+id/btnVolverPdf"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:text="‹ Volver"
        android:backgroundTint="@color/primaryBlue"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:layout_margin="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reporte de asistencia"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Presiona el botón para generar y guardar tu reporte en PDF en la carpeta de Descargas."
        android:textSize="14sp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp"/>

    <Button
        android:id="@+id/btnGenerarPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Generar y guardar PDF"
        android:backgroundTint="@color/primaryBlue"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:layout_margin="16dp"/>

</LinearLayout>