<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/backgroundGray">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:background="@color/primaryBlue"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/ControlAssistace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CONTROL-ASSISTENCE"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CA"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alumno"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:layout_below="@id/ControlAssistace"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:paddingBottom="6dp"/>
    </RelativeLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- CARD ACCIONES -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACCIONES"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"
                        android:layout_marginBottom="20dp"/>

                    <!-- BOTÓN ESCANEAR QR -->
                    <Button
                        android:id="@+id/btnEscanearQR"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="Escanear código QR"
                        android:backgroundTint="#C8D8F0"
                        android:textColor="@color/primaryBlue"
                        android:textSize="15sp"
                        android:textAllCaps="false"
                        android:layout_marginBottom="16dp"/>

                    <!-- BOTÓN REPORTE -->
                    <Button
                        android:id="@+id/btnReporte"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="Reporte personal"
                        android:backgroundTint="#F5F0C8"
                        android:textColor="#7A7000"
                        android:textSize="15sp"
                        android:textAllCaps="false"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>