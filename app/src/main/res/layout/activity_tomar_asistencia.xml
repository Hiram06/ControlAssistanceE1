<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#E6E6E6">

    <TextView
        android:id="@+id/tvTituloAsistencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tomar asistencia"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="16dp"/>

    <TextView
        android:id="@+id/tvAlumnoActual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cargando alumnos..."
        android:textSize="16sp"
        android:gravity="center"
        android:padding="8dp"/>

    <ImageView
        android:id="@+id/ivQRMaestro"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnNuevoQR"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Regenerar QR"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnSiguienteAlumno"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Siguiente alumno"/>

</LinearLayout>